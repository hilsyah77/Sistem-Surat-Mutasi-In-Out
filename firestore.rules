rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Students collection: Readable by all, writable when authenticated or demo mode
    match /students/{studentId} {
      allow read, write: if true; // Open for school management app demonstration
    }

    // Transfers In collection
    match /transfers_in/{transferId} {
      allow read, write: if true;
    }

    // Transfers Out collection
    match /transfers_out/{transferId} {
      allow read, write: if true;
    }

    // Grades collection
    match /grades/{gradeId} {
      allow read, write: if true;
    }

    // Settings collection
    match /institution_settings/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
